{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "keyword": {
                "type": ["string", "null"],
                "title": "Search keyword",
                "description": "The search query used to find this product.",
                "example": "laptop gaming"
            },
            "page": {
                "type": ["number", "null"],
                "title": "Page number",
                "description": "Which page of results this product appeared on.",
                "example": 1
            },
            "position": {
                "type": ["number", "null"],
                "title": "Position",
                "description": "Position in the search results (1-indexed).",
                "example": 1
            },
            "productId": {
                "type": ["string", "null"],
                "title": "Product ID",
                "description": "Tokopedia product ID.",
                "example": "6699703868"
            },
            "title": {
                "type": ["string", "null"],
                "title": "Product title",
                "description": "Full product title as shown in search results.",
                "example": "QKZ AK6 Upgrade Earphone Bass Sport Gaming Headset"
            },
            "price": {
                "type": ["number", "null"],
                "title": "Price (IDR)",
                "description": "Current selling price in Indonesian rupiah. Integer, no separators.",
                "example": 24900
            },
            "priceText": {
                "type": ["string", "null"],
                "title": "Price (formatted)",
                "description": "Display price exactly as Tokopedia renders it.",
                "example": "Rp24.900"
            },
            "originalPrice": {
                "type": ["number", "null"],
                "title": "Original price (IDR)",
                "description": "Pre-discount price. Null when the product has no discount.",
                "example": 64900
            },
            "discount": {
                "type": ["number", "null"],
                "title": "Discount (IDR)",
                "description": "Absolute discount in rupiah, always equal to originalPrice - price. Null when there is no discount.",
                "example": 40000
            },
            "discountPercent": {
                "type": "number",
                "title": "Discount %",
                "description": "Discount percentage, 0 when the product has no discount.",
                "example": 62
            },
            "currency": {
                "type": "string",
                "title": "Currency",
                "description": "ISO currency code. Always IDR for Tokopedia.",
                "example": "IDR"
            },
            "imageUrl": {
                "type": ["string", "null"],
                "title": "Main image URL",
                "description": "Main product image. Tokopedia signs these URLs, so download or mirror them soon after scraping if you need them long-term.",
                "example": "https://p16-images-sign-sg.tokopedia-static.net/..."
            },
            "imageUrls": {
                "type": "array",
                "title": "All image URLs",
                "description": "Array of all product image URLs.",
                "example": ["https://p16-images-sign-sg.tokopedia-static.net/..."]
            },
            "url": {
                "type": ["string", "null"],
                "title": "Product URL",
                "description": "Canonical product page URL on tokopedia.com.",
                "example": "https://www.tokopedia.com/kupingsensi/qkz-ak6-headset..."
            },
            "shopId": {
                "type": ["string", "null"],
                "title": "Shop ID",
                "description": "Tokopedia shop ID.",
                "example": "10426449"
            },
            "shopName": {
                "type": ["string", "null"],
                "title": "Shop name",
                "description": "Display name of the seller.",
                "example": "Kuping Sensi"
            },
            "shopUrl": {
                "type": ["string", "null"],
                "title": "Shop URL",
                "description": "Seller's shop page URL on Tokopedia.",
                "example": "https://www.tokopedia.com/kupingsensi"
            },
            "shopCity": {
                "type": ["string", "null"],
                "title": "Shop city",
                "description": "Seller's registered city, useful for shipping and regional analysis.",
                "example": "Jakarta Barat"
            },
            "shopTier": {
                "type": ["number", "null"],
                "title": "Shop tier",
                "description": "Seller's tier level on Tokopedia (higher = more established).",
                "example": 2
            },
            "isOfficialStore": {
                "type": "boolean",
                "title": "Official store",
                "description": "True when the seller is an official/brand store on Tokopedia."
            },
            "isPowerMerchant": {
                "type": "boolean",
                "title": "Power merchant",
                "description": "True when the seller holds Tokopedia's Power Merchant badge."
            },
            "badgeTitle": {
                "type": ["string", "null"],
                "title": "Badge title",
                "description": "Text on the seller's badge (e.g., 'Official Store', city name).",
                "example": "Surabaya"
            },
            "badgeUrl": {
                "type": ["string", "null"],
                "title": "Badge URL",
                "description": "URL of the badge image.",
                "example": "https://p16-images-comn-sg.tokopedia-static.net/..."
            },
            "rating": {
                "type": "number",
                "title": "Rating",
                "description": "Average product rating. 0 when the product has no ratings.",
                "example": 4.9
            },
            "reviewCount": {
                "type": "number",
                "title": "Review count",
                "description": "Number of product reviews. 0 when the product has no reviews.",
                "example": 128
            },
            "favoriteCount": {
                "type": "number",
                "title": "Favorite count",
                "description": "How many users wishlisted the product. 0 when unavailable."
            },
            "soldCount": {
                "type": ["number", "null"],
                "title": "Sold count",
                "description": "Units sold as shown on the listing. Null when the shop does not display it."
            },
            "categoryId": {
                "type": ["string", "null"],
                "title": "Category ID",
                "description": "Tokopedia category ID.",
                "example": "297"
            },
            "categoryName": {
                "type": ["string", "null"],
                "title": "Category name",
                "description": "Tokopedia category the product belongs to.",
                "example": "Komputer & Laptop"
            },
            "categoryBreadcrumb": {
                "type": ["string", "null"],
                "title": "Category breadcrumb",
                "description": "Full category path (e.g., 'komputer-laptop/aksesoris-komputer-laptop/adaptor-laptop').",
                "example": "komputer-laptop/aksesoris-komputer-laptop/adaptor-laptop"
            },
            "isAd": {
                "type": "boolean",
                "title": "Is advertisement",
                "description": "True if this product is a sponsored/advertisement result."
            },
            "isWishlist": {
                "type": "boolean",
                "title": "Is wishlisted",
                "description": "True if the product is in the user's wishlist."
            },
            "weight": {
                "type": ["number", "null"],
                "title": "Weight (gram)",
                "description": "Product weight in grams. Useful for shipping cost calculation.",
                "example": 500
            },
            "stock": {
                "type": ["number", "null"],
                "title": "Stock",
                "description": "Available stock quantity. Null when not displayed.",
                "example": 100
            },
            "condition": {
                "type": ["string", "null"],
                "title": "Condition",
                "description": "Product condition: 'Baru' (new) or 'Bekas' (used).",
                "example": "Baru"
            },
            "minOrder": {
                "type": ["number", "null"],
                "title": "Minimum order",
                "description": "Minimum order quantity. Null when default is 1.",
                "example": 1
            },
            "wholesalePrice": {
                "type": ["number", "null"],
                "title": "Wholesale price (IDR)",
                "description": "Wholesale/bulk price when available. Null when no wholesale pricing.",
                "example": 20000
            },
            "fetchedAt": {
                "type": "string",
                "title": "Fetched at",
                "description": "ISO 8601 timestamp of when the item was extracted.",
                "example": "2026-09-17T00:50:34.458Z"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "One row per product: what it is, what it costs, and where to buy it.",
            "transformation": {
                "fields": [
                    "imageUrl",
                    "title",
                    "price",
                    "originalPrice",
                    "discountPercent",
                    "shopName",
                    "url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "imageUrl": {
                        "label": "Image",
                        "format": "image"
                    },
                    "title": {
                        "label": "Product",
                        "format": "text"
                    },
                    "price": {
                        "label": "Price (IDR)",
                        "format": "number"
                    },
                    "originalPrice": {
                        "label": "Was (IDR)",
                        "format": "number"
                    },
                    "discountPercent": {
                        "label": "Discount %",
                        "format": "number"
                    },
                    "shopName": {
                        "label": "Shop",
                        "format": "text"
                    },
                    "url": {
                        "label": "Link",
                        "format": "link"
                    }
                }
            }
        },
        "pricing": {
            "title": "Pricing analysis",
            "description": "Everything needed to compare price levels and discount depth across shops.",
            "transformation": {
                "fields": [
                    "title",
                    "price",
                    "originalPrice",
                    "discount",
                    "discountPercent",
                    "currency",
                    "shopName",
                    "shopCity"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "price": {
                        "label": "Price",
                        "format": "number"
                    },
                    "originalPrice": {
                        "label": "Original",
                        "format": "number"
                    },
                    "discount": {
                        "label": "Discount (IDR)",
                        "format": "number"
                    },
                    "discountPercent": {
                        "label": "Discount %",
                        "format": "number"
                    }
                }
            }
        },
        "sellers": {
            "title": "Sellers",
            "description": "Shop-level view: who is selling, where from, and how established they are.",
            "transformation": {
                "fields": [
                    "shopName",
                    "shopCity",
                    "shopTier",
                    "isOfficialStore",
                    "isPowerMerchant",
                    "rating",
                    "reviewCount",
                    "soldCount",
                    "title"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "shopTier": {
                        "label": "Tier",
                        "format": "number"
                    },
                    "isOfficialStore": {
                        "label": "Official",
                        "format": "boolean"
                    },
                    "isPowerMerchant": {
                        "label": "Power merchant",
                        "format": "boolean"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "reviewCount": {
                        "label": "Reviews",
                        "format": "number"
                    },
                    "soldCount": {
                        "label": "Sold",
                        "format": "number"
                    }
                }
            }
        }
    }
}
